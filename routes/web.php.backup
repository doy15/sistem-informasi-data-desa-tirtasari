Route::prefix('pemilihan')
    ->name('pemilihan.')
    ->controller(\App\Http\Controllers\PemilihanController::class)
    ->group(function () {
        Route::get('/', 'index')->name('index');
        Route::get('/tambah', 'create')->name('create');
        Route::post('/', 'store')->name('store');

        // Tambah TPS
        Route::post('/{pemilihan}/tps', 'storeTps')
            ->name('tps.store');

        // Simpan alokasi RT ke TPS
        Route::post('/{pemilihan}/tps/{tps}/rt', 'updateRt')
            ->name('tps.rt.update');

        // Detail pemilihan
        Route::get('/{pemilihan}', 'show')->name('show');
    });

