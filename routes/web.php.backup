|--------------------------------------------------------------------------
| Dashboard
|--------------------------------------------------------------------------
*/

Route::get('/', [DashboardController::class, 'index'])
    ->name('dashboard');

/*
|--------------------------------------------------------------------------
| Penduduk
|--------------------------------------------------------------------------
*/

Route::get('/penduduk', function (Request $request) {
    $query = Penduduk::with('kartuKeluarga.rt.rw.dusun');

    // Pencarian nama, NIK, nomor KK, dan alamat.
    if ($request->filled('search')) {
        $search = trim($request->input('search'));

        $query->where(function ($q) use ($search) {
            $q->where('nama_lengkap', 'like', "%{$search}%")
                ->orWhere('nik', 'like', "%{$search}%")
                ->orWhereHas('kartuKeluarga', function ($kk) use ($search) {
                    $kk->where('no_kk', 'like', "%{$search}%")
                        ->orWhere('alamat', 'like', "%{$search}%");
                });
        });
    }

    // Filter jenis kelamin.
    if ($request->filled('jenis_kelamin')) {
        $jenisKelamin = strtoupper(
            trim($request->input('jenis_kelamin'))
        );

        if (in_array($jenisKelamin, ['LAKI-LAKI', 'PEREMPUAN'])) {
            $query->whereRaw(
                'UPPER(TRIM(jenis_kelamin)) = ?',
                [$jenisKelamin]
            );
        }
    }

    $penduduks = $query
        ->orderBy('nama_lengkap')
        ->get();

    return view('penduduk.index', [
        'penduduks' => $penduduks,
    ]);
})->name('penduduk.index');

Route::get('/penduduk/tambah', [PendudukController::class, 'create'])
    ->name('penduduk.create');

Route::post('/penduduk', [PendudukController::class, 'store'])
    ->name('penduduk.store');

Route::get('/penduduk/{id}/edit', [PendudukController::class, 'edit'])
    ->name('penduduk.edit');

Route::put('/penduduk/{id}', [PendudukController::class, 'update'])
    ->name('penduduk.update');

/*
|--------------------------------------------------------------------------
| Kartu Keluarga
|--------------------------------------------------------------------------
*/

Route::get('/keluarga', function () {
    $kartuKeluargas = KartuKeluarga::with([
        'rt.rw.dusun',
        'penduduks',
    ])
        ->orderBy('no_kk')
        ->get();

    return view('keluarga.index', [
        'kartuKeluargas' => $kartuKeluargas,
    ]);
})->name('keluarga.index');

Route::get('/keluarga/tambah', [
    KartuKeluargaController::class,
    'create',
])->name('keluarga.create');

Route::post('/keluarga', [
    KartuKeluargaController::class,
    'store',
])->name('keluarga.store');

Route::get('/keluarga/{id}', function ($id) {
    $kartuKeluarga = KartuKeluarga::with([
        'penduduks',
        'rt.rw.dusun',
    ])->findOrFail($id);

    return view('keluarga.show', [
        'kartuKeluarga' => $kartuKeluarga,
    ]);
})->name('keluarga.show');

